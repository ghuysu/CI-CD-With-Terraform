# =========================================================
# Terraform
# =========================================================

# Terraform working directory
.terraform/
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files
# Không commit tfvars nếu chứa secret / sensitive values
*.tfvars.json

# Terraform plan files
*.tfplan
tfplan
tfplan-*

# Terraform lock file
# KEEP this file in Git
# .terraform.lock.hcl


# =========================================================
